<view class="container">
  <view class="ota-card glass">
    <view class="header">
      <text class="title">固件升级</text>
      <text class="subtitle">{{target === 'esp32' ? 'ESP32 System Update' : 'STM32 Motor Control Update'}}</text>
    </view>

    <view class="version-info">
      <text class="label">当前版本:</text>
      <text class="value">{{deviceVersion}}</text>
    </view>

    <view class="target-selector" wx:if="{{!updating}}">
      <view class="target-btn {{target === 'esp32' ? 'active' : ''}}" bindtap="switchTarget" data-target="esp32">ESP32</view>
      <view class="target-btn {{target === 'stm32' ? 'active' : ''}}" bindtap="switchTarget" data-target="stm32">STM32</view>
    </view>

    <view class="status-section">
      <view class="progress-circle">
        <svg class="svg-ring" viewBox="0 0 100 100">
          <circle class="bg" cx="50" cy="50" r="45"></circle>
          <circle class="active" cx="50" cy="50" r="45" style="stroke-dashoffset: {{440 - (440 * progress / 100)}}"></circle>
        </svg>
        <view class="progress-text">
          <text class="percent">{{progress}}%</text>
          <text class="speed">{{speed}} KB/s</text>
        </view>
      </view>
    </view>

    <view class="file-info" wx:if="{{fileName}}">
      <text class="file-name">{{fileName}}</text>
      <text class="file-size">{{fileSize}} KB</text>
    </view>

    <view class="action-section">
      <button wx:if="{{!updating}}" class="btn-cloud" bindtap="checkCloudUpdate">检测新版本</button>
      <button wx:if="{{!updating}}" class="btn-outline" bindtap="chooseFile">本地选择文件</button>
      <button wx:if="{{updating}}" class="btn-danger" bindtap="abortUpdate">取消升级</button>
    </view>
  </view>

  <view class="log-panel glass">
    <scroll-view scroll-y class="log-scroll" scroll-top="{{scrollTop}}">
      <view wx:for="{{logs}}" wx:key="index" class="log-line">
        <text class="log-time">{{item.time}}</text>
        <text class="log-msg">{{item.msg}}</text>
      </view>
    </scroll-view>
  </view>
</view>
